{
  "info": {
    "name": "Lab Equipment Loan System",
    "description": "Koleksi request untuk menguji seluruh endpoint Lab Equipment Loan System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "Items",
      "item": [
        {
          "name": "GET /items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            }
          }
        },
        {
          "name": "POST /items",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Multimeter\",\n  \"total_stock\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["items"]
            }
          }
        }
      ]
    },
    {
      "name": "Loans",
      "item": [
        {
          "name": "POST /loans",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": \"20240001\",\n  \"item_id\": 1,\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/loans",
              "host": ["{{baseUrl}}"],
              "path": ["loans"]
            }
          }
        },
        {
          "name": "PUT /loans/:id/return",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/loans/1/return",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "1", "return"]
            }
          }
        },
        {
          "name": "GET /loans/student/:student_id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/loans/student/20240001",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "student", "20240001"]
            }
          }
        }
      ]
    }
  ]
}
